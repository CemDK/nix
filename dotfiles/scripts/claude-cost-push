#!/usr/bin/env node
// claude-cost-push — publish this machine's Claude Code cost and token usage to
// Home Assistant as long-term statistics (home-assistant repo: System dashboard,
// "Claude" view).
//
// Source: `ccusage claude daily --json`, which prices the transcripts under
// ~/.claude/projects. The cost is API-equivalent, not what the subscription bills.
// Claude Code purges transcripts after ~30 days, so totals cannot be recomputed
// later: HA's statistics are the ledger, and this script only ever adds to it.
//
// Two layers of external statistics (source "claude"), `sum` cumulative, `state`
// that day's value. One row per day at 23:00 in HA's time zone; today's row sits
// in the last complete hour, because HA ignores the running hour of an external
// statistic. HA measures a period's change against the row one hour before the
// period starts, so every day needs its 23:00 row, days without usage included.
// Before 01:00 today has no complete hour yet and is left out until then:
//   claude:raw_<metric>_<family>_h_<host>   this machine's own series
//   claude:<metric>_<family>, claude:<metric>   sum over all machines
// metric = cost | tokens_io (input + output) | tokens_total (+ cache write/read)
// family = fable | opus | sonnet | haiku | other
// Every machine imports its own raw series, then rebuilds the aggregates from all
// raw series in HA, so no machine needs to know about the others. Imports upsert
// by (id, start): re-running never double-counts.
//
// HA_URL and HA_TOKEN come from the environment, else from
// ${CLAUDE_USAGE_ENV:-~/.config/claude/secrets.env}. Runs at most once per
// MIN_INTERVAL seconds unless --force. --quiet prints nothing on success.
// --dry-run computes everything and imports nothing.

import { execFileSync } from "node:child_process";
import fs from "node:fs";
import os from "node:os";
import path from "node:path";

const METRICS = { cost: "USD", tokens_io: "tokens", tokens_total: "tokens" };
const METRIC_NAMES = { cost: "cost", tokens_io: "tokens (in+out)", tokens_total: "tokens (all)" };
const FAMILIES = ["fable", "opus", "sonnet", "haiku", "other"];
const LEDGER_START = "2026-08-01T00:00:00Z"; // before the first transcript anywhere
const RAW_ID = /^claude:raw_(cost|tokens_io|tokens_total)_([a-z0-9]+)_h_([a-z0-9_]+)$/;

const args = new Set(process.argv.slice(2));
for (const a of args) {
  if (!["--force", "--quiet", "--dry-run"].includes(a)) {
    console.error("usage: claude-cost-push [--force] [--quiet] [--dry-run]");
    process.exit(2);
  }
}
const say = (...m) => args.has("--quiet") || console.log(...m);
const die = (m) => { console.error(`claude-cost-push: ${m}`); process.exit(1); };

const STATE = path.join(process.env.XDG_CACHE_HOME || path.join(os.homedir(), ".cache"), "claude-statusline");
const STAMP = path.join(STATE, "cost-push.last");
const MIN_INTERVAL = Number(process.env.MIN_INTERVAL || 600);
fs.mkdirSync(STATE, { recursive: true });
const now = Math.floor(Date.now() / 1000);
if (!args.has("--force") && !args.has("--dry-run") && fs.existsSync(STAMP)) {
  const last = Number(fs.readFileSync(STAMP, "utf8")) || 0;
  if (now - last < MIN_INTERVAL) { say(`skipped: ran ${now - last}s ago`); process.exit(0); }
}
// Stamp before the work: the status line fires this on every render, and a slow
// run must not pile up behind itself.
if (!args.has("--dry-run")) fs.writeFileSync(STAMP, String(now));

// ── credentials ────────────────────────────────────────────────────────────
let { HA_URL, HA_TOKEN } = process.env;
if (!HA_URL || !HA_TOKEN) {
  const envFile = process.env.CLAUDE_USAGE_ENV || path.join(os.homedir(), ".config/claude/secrets.env");
  if (fs.existsSync(envFile)) {
    for (const line of fs.readFileSync(envFile, "utf8").split("\n")) {
      const m = line.match(/^\s*(?:export\s+)?(HA_URL|HA_TOKEN)=(.*)$/);
      if (!m) continue;
      const v = m[2].trim().replace(/^(['"])(.*)\1$/, "$2");
      if (m[1] === "HA_URL") HA_URL ||= v; else HA_TOKEN ||= v;
    }
  }
}
if (!HA_URL || !HA_TOKEN) die("HA_URL/HA_TOKEN not set (environment or ~/.config/claude/secrets.env)");

// ── Home Assistant WebSocket ───────────────────────────────────────────────
const ws = new WebSocket(HA_URL.replace(/^http/, "ws").replace(/\/$/, "") + "/api/websocket");
const pending = new Map();
let nextId = 1;
const ready = new Promise((resolve, reject) => {
  ws.onerror = () => reject(new Error("cannot reach Home Assistant"));
  ws.onclose = () => reject(new Error("Home Assistant closed the connection"));
  ws.onmessage = (ev) => {
    const msg = JSON.parse(ev.data);
    if (msg.type === "auth_required") ws.send(JSON.stringify({ type: "auth", access_token: HA_TOKEN }));
    else if (msg.type === "auth_ok") resolve();
    else if (msg.type === "auth_invalid") reject(new Error("Home Assistant rejected HA_TOKEN"));
    else if (msg.type === "result") {
      const p = pending.get(msg.id);
      pending.delete(msg.id);
      if (msg.success) p?.resolve(msg.result); else p?.reject(new Error(`${p.type}: ${msg.error?.message}`));
    }
  };
});
const call = (type, payload = {}) => new Promise((resolve, reject) => {
  const id = nextId++;
  pending.set(id, { resolve, reject, type });
  ws.send(JSON.stringify({ id, type, ...payload }));
});

// ── days in HA's time zone ─────────────────────────────────────────────────
let TZ;
const dayOf = (ms) => new Intl.DateTimeFormat("en-CA", { timeZone: TZ }).format(new Date(ms));
function tzOffset(ms) {
  const f = new Intl.DateTimeFormat("en-US", { timeZone: TZ, hourCycle: "h23", year: "numeric", month: "2-digit",
    day: "2-digit", hour: "2-digit", minute: "2-digit", second: "2-digit" });
  const p = Object.fromEntries(f.formatToParts(new Date(ms)).map((x) => [x.type, Number(x.value)]));
  return Date.UTC(p.year, p.month - 1, p.day, p.hour, p.minute, p.second) - ms;
}
let today;
function slot(day) { // the hour a day's row lives at, as an ISO instant
  if (day === today) return new Date((Math.floor(Date.now() / 3600e3) - 1) * 3600e3).toISOString();
  const [y, m, d] = day.split("-").map(Number);
  const wall = Date.UTC(y, m - 1, d, 23);
  return new Date(wall - tzOffset(wall - tzOffset(wall))).toISOString();
}
function daysBetween(first, last) {
  const out = [];
  for (let t = Date.parse(first + "T12:00:00Z"); ; t += 86400e3) {
    const d = new Date(t).toISOString().slice(0, 10);
    if (d > last) return out;
    out.push(d);
  }
}

// ── this machine's usage ───────────────────────────────────────────────────
function ccusage() {
  const argv = ["claude", "daily", "--json", "--timezone", TZ];
  const opts = { encoding: "utf8", maxBuffer: 64 << 20, stdio: ["ignore", "pipe", "ignore"] };
  let out;
  try { out = execFileSync("ccusage", argv, opts); }
  catch (e) {
    if (e.code !== "ENOENT") throw e;
    out = execFileSync("nix", ["run", "nixpkgs#ccusage", "--", ...argv], opts); // not installed: run it from the registry
  }
  return JSON.parse(out).daily ?? [];
}
const family = (model) => (/fable|mythos/.test(model) ? "fable" : FAMILIES.find((f) => model.includes(f)) ?? "other");

function localUsage() { // {metric: {family: {day: value}}}
  const usage = {};
  for (const row of ccusage()) {
    const day = row.date ?? row.period;
    for (const mb of row.modelBreakdowns ?? []) {
      const io = (mb.inputTokens ?? 0) + (mb.outputTokens ?? 0);
      const values = { cost: mb.cost ?? 0, tokens_io: io,
        tokens_total: io + (mb.cacheCreationTokens ?? 0) + (mb.cacheReadTokens ?? 0) };
      for (const [metric, v] of Object.entries(values)) {
        const days = ((usage[metric] ??= {})[family(mb.modelName ?? "")] ??= {});
        days[day] = (days[day] ?? 0) + v;
      }
    }
  }
  return usage;
}

const meta = (statistic_id, name, unit) => ({ statistic_id, name, source: "claude", unit_of_measurement: unit,
  unit_class: null, has_mean: false, mean_type: 0, has_sum: true });
const round = (v) => Math.round(v * 1e6) / 1e6;
const EPS = 1e-4;

async function main() {
  await ready;
  TZ = (await call("get_config")).time_zone;
  today = dayOf(Date.now());
  const lastDay = dayOf(Date.now() - 3600e3); // yesterday until 01:00, see the header
  const recent = dayOf(Date.now() - 2 * 86400e3); // always rewritten, so yesterday's 23:00 row exists
  const host = os.hostname().split(".")[0].toLowerCase().replace(/[^a-z0-9]+/g, "_").replace(/^_|_$/g, "");

  // The ledger so far: cumulative sum per raw series per day.
  const ids = (await call("recorder/list_statistic_ids", { statistic_type: "sum" }))
    .map((s) => s.statistic_id).filter((id) => RAW_ID.test(id));
  const stored = ids.length ? await call("recorder/statistics_during_period",
    { start_time: LEDGER_START, period: "day", statistic_ids: ids, types: ["sum"] }) : {};
  const ledger = {}; // id -> {day: sum}
  for (const id of ids) ledger[id] = Object.fromEntries((stored[id] ?? []).map((r) => [dayOf(r.start), r.sum]));

  // Own raw series. A day never shrinks: once transcripts are purged, ccusage
  // reports less for it than what was already imported.
  const imports = []; // [metadata, rows]
  let firstChanged = null;
  const usage = localUsage();
  for (const metric of Object.keys(METRICS)) {
    for (const [fam, fresh] of Object.entries(usage[metric] ?? {})) {
      const id = `claude:raw_${metric}_${fam}_h_${host}`;
      const old = (ledger[id] ??= {});
      const oldDays = Object.keys(old).sort();
      const first = [Object.keys(fresh).sort()[0], oldDays[0]].filter(Boolean).sort()[0];
      let sum = 0, prevOld = 0;
      const rows = [];
      for (const day of daysBetween(first, lastDay)) {
        const oldValue = day in old ? old[day] - prevOld : 0;
        if (day in old) prevOld = old[day];
        // Stored sums are rounded, so a day counts as unchanged within EPS;
        // otherwise the rounding error drifts through every later sum.
        const freshValue = fresh[day] ?? 0;
        const value = Math.abs(freshValue - oldValue) < EPS ? oldValue : Math.max(freshValue, oldValue);
        sum = round(sum + value);
        if (day >= recent || Math.abs((old[day] ?? -1) - sum) > EPS) {
          rows.push({ start: slot(day), sum, state: round(value) });
          if (!firstChanged || day < firstChanged) firstChanged = day;
        }
        old[day] = sum;
      }
      if (rows.length) imports.push([meta(id, `Claude ${METRIC_NAMES[metric]} ${fam} @${host}`, METRICS[metric]), rows]);
    }
  }

  // Aggregates over all machines, rewritten from the first day that changed.
  // A series with no row on a day keeps its previous sum.
  const totals = {};
  if (firstChanged) {
    const groups = {}; // aggregate id -> [raw ids]
    for (const id of Object.keys(ledger)) {
      const [, metric, fam] = id.match(RAW_ID);
      (groups[`claude:${metric}_${fam}`] ??= []).push(id);
      (groups[`claude:${metric}`] ??= []).push(id);
    }
    const firstDay = Object.values(ledger).flatMap((d) => Object.keys(d)).sort()[0];
    for (const [aggId, rawIds] of Object.entries(groups)) {
      const carried = Object.fromEntries(rawIds.map((id) => [id, 0]));
      const rows = [];
      let prev = 0;
      for (const day of daysBetween(firstDay, lastDay)) {
        for (const id of rawIds) if (day in ledger[id]) carried[id] = ledger[id][day];
        const sum = Object.values(carried).reduce((a, b) => a + b, 0);
        if (day >= firstChanged) rows.push({ start: slot(day), sum: round(sum), state: round(sum - prev) });
        if (day === lastDay) totals[aggId] = { today: sum - prev, total: sum };
        prev = sum;
      }
      const [, metric, fam] = aggId.match(/^claude:(cost|tokens_io|tokens_total)(?:_(\w+))?$/);
      imports.push([meta(aggId, `Claude ${METRIC_NAMES[metric]}${fam ? " " + fam : ""}`, METRICS[metric]), rows]);
    }
  }

  for (const [metadata, stats] of imports) {
    if (args.has("--dry-run")) say(`${metadata.statistic_id}: ${stats.length} rows, last sum ${stats.at(-1).sum}`);
    else await call("recorder/import_statistics", { metadata, stats });
  }
  const fmt = (n) => (n >= 1e6 ? (n / 1e6).toFixed(1) + "M" : n >= 1e3 ? (n / 1e3).toFixed(0) + "k" : String(Math.round(n)));
  const t = (id) => totals[id] ?? { today: 0, total: 0 };
  say(`${args.has("--dry-run") ? "would push" : "pushed"} ${host}: today $${t("claude:cost").today.toFixed(2)}, ` +
    `${fmt(t("claude:tokens_io").today)} in+out, ${fmt(t("claude:tokens_total").today)} all · ` +
    `total $${t("claude:cost").total.toFixed(2)}, ${fmt(t("claude:tokens_io").total)} in+out, ${fmt(t("claude:tokens_total").total)} all`);
}

main().then(() => process.exit(0), (e) => die(e.message));
