{
    "$schema": "https://json.schemastore.org/claude-code-settings.json",
    "attribution": {
        "commit": "",
        "pr": ""
    },
    "permissions": {
        "allow": [
            "WebFetch",
            "WebSearch",
            "Glob",
            "Grep",
            "LS",
            "Read",
            "NotebookRead",
            "Task",
            "TodoWrite",
            "Bash(cat:*)",
            "Bash(date:*)",
            "Bash(echo:*)",
            "Bash(file:*)",
            "Bash(find:*)",
            "Bash(grep:*)",
            "Bash(head:*)",
            "Bash(ls:*)",
            "Bash(mkdir:*)",
            "Bash(pnpm lint:*)",
            "Bash(sort:*)",
            "Bash(tail:*)",
            "Bash(tr:*)",
            "Bash(wc:*)",
            "Skill(frontend-design)",
            "Skill(frontend-design:frontend-design)"
        ],
        "deny": [
            "Read(.env)",
            "Read(.env.*)",
            "Read(**/secrets/*)",
            "Read(**/*credential*)",
            "Read(**/*.pem)",
            "Read(**/*.key)"
        ],
        "defaultMode": "auto"
    },
    "model": "claude-fable-5[1m]",
    "skillOverrides": {
        "vercel-composition-patterns": "off",
        "vercel-react-best-practices": "off",
        "web-design-guidelines": "off"
    },
    "statusLine": {
        "type": "command",
        "command": "~/.claude/statusline.sh"
    },
    "enabledPlugins": {
        "frontend-design@claude-plugins-official": true,
        "feature-dev@claude-plugins-official": true,
        "code-review@claude-plugins-official": false,
        "security-guidance@claude-plugins-official": true,
        "agent-sdk-dev@claude-plugins-official": false,
        "explanatory-output-style@claude-plugins-official": false,
        "rust-analyzer-lsp@claude-plugins-official": false,
        "typescript-lsp@claude-plugins-official": false,
        "lua-lsp@claude-plugins-official": false,
        "plugin-dev@claude-plugins-official": false,
        "learning-output-style@claude-plugins-official": false,
        "pr-review-toolkit@claude-plugins-official": true,
        "code-review@claude-code-plugins": false,
        "claude-code-wakatime@wakatime": true,
        "figma@claude-plugins-official": false
    },
    "extraKnownMarketplaces": {
        "claude-code-plugins": {
            "source": {
                "source": "github",
                "repo": "anthropics/claude-code"
            }
        },
        "wakatime": {
            "source": {
                "source": "git",
                "url": "https://github.com/wakatime/claude-code-wakatime.git"
            }
        }
    },
    "theme": "dark",
    "alwaysThinkingEnabled": true,
    "effortLevel": "high",
    "promptSuggestionEnabled": false,
    "awaySummaryEnabled": false,
    "showClearContextOnPlanAccept": true,
    "tui": "fullscreen",
    "skipWorkflowUsageWarning": true,
    "editorMode": "vim",
    "verbose": true,
    "agentPushNotifEnabled": true,
    "voiceEnabled": true
}
